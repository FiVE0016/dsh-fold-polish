{
  "name": "dsh-fold-polish",
  "version": "1.1.1",
  "description": "DeepSeek Harness conversation polish: message and step folding, composer and sidebar sizing, folded-content search, turn timing, and confirmed local conversation history deletion.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "fold",
    "collapse",
    "transcript",
    "ui",
    "beautify",
    "sidebar",
    "composer",
    "search"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "src",
    "scripts/build.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "FiVE0016",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiVE0016/dsh-fold-polish.git"
  },
  "homepage": "https://github.com/FiVE0016/dsh-fold-polish#readme",
  "bugs": {
    "url": "https://github.com/FiVE0016/dsh-fold-polish/issues"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/regression-check.mjs --fast",
    "test:browser": "node test/rewrite-browser.mjs",
    "check": "node scripts/regression-check.mjs"
  }
}
