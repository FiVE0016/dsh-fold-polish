{
  "name": "dsh-fold-polish",
  "version": "0.10.1",
  "description": "Display polish for the DeepSeek Harness conversation: fold overlong messages and work-step blocks, resize the composer and the right sidebar, and search folded content. Pure client-side and display-only.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "client-plugin",
    "fold",
    "collapse",
    "transcript",
    "ui",
    "beautify",
    "sidebar",
    "composer",
    "search"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "assets/demo.gif",
    "assets/step-fold-default.png",
    "assets/step-fold-expanded.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "engines": {
    "node": ">=20.0.0",
    "dsh": ">=0.2.0-rc.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "FiVE0016",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FiVE0016/dsh-fold-polish.git"
  },
  "homepage": "https://github.com/FiVE0016/dsh-fold-polish#readme",
  "bugs": {
    "url": "https://github.com/FiVE0016/dsh-fold-polish/issues"
  }
}
